{
  "name": "@kxh4892636/etf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm run dev:server\" \"pnpm run dev:web\"",
    "dev:server": "node --watch --experimental-strip-types server/main.ts",
    "dev:web": "vp dev",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vp build",
    "start": "node dist/server/main.js",
    "preview": "vp preview",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "sync:market": "node --experimental-strip-types server/sync-market.ts",
    "sync:valuation": "node --experimental-strip-types server/sync-valuation.ts"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.2.5",
    "@hono/node-server": "2.1.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.8",
    "@tanstack/react-router": "^1.169.1",
    "antd": "^6.4.3",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitest/browser-playwright": "5.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "0.31.10",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1",
    "vitest-browser-react": "^2.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.22.0"
}
